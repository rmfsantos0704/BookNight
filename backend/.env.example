# Server
PORT=5000
NODE_ENV=development

# MongoDB Atlas
MONGO_URI=mongodb+srv://<user>:<password>@<cluster>.mongodb.net/bookmark-engine?retryWrites=true&w=majority

# JWT
JWT_SECRET=replace_this_with_a_long_random_string
JWT_EXPIRES_IN=7d

# Redis (BullMQ queue - used by the scraping worker service too)
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=

# CORS
CLIENT_ORIGIN=http://localhost:5173

# Password reset mailer (Gmail example)
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_SECURE=false
EMAIL_USER=russelsantos142@gmail.com
EMAIL_PASS=your_gmail_app_password_here
EMAIL_FROM=russelsantos142@gmail.com
